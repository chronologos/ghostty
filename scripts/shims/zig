#!/usr/bin/env bash
# Several Zig toolchains live on this machine side by side, as `zig-<major.minor>`
# on PATH: this repo and zmx move to a new Zig at different times (0.17 and 0.16
# as of 2026-10), and the system `zig` lags both. Pick per *project*, from the
# nearest ancestor build.zig.zon: a project declaring an X.Y.z
# `minimum_zig_version` gets `zig-X.Y` if that exists; anything else falls through
# to the real system `zig`. This dir sits on PATH beyond this repo — .envrc.local
# `PATH_add`s it, and zmx deploy scripts may prepend it — so an unconditional shim
# would hijack another project's build. It must be a real PATH shim, not an alias: upstream's
# `translate_c` build dependency discovers the Zig lib dir by running `zig env`
# (whatever `zig` is on PATH), so both the entry point and that probe have to
# resolve the same way.
#
# `zig-X.Y` is a symlink in ~/.local/bin to ~/.local/share/zig-X.Y.Z/zig, an unpacked
# official tarball. When upstream raises its minimum, install the new release beside the
# old ones; this file needs no edit. scripts/fork-release.sh documents the layout and, when
# the toolchain is missing, prints the install commands for the version this tree needs.
self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"

# Nearest build.zig.zon walking up from $PWD → its declared minimum version.
want=""
d="$PWD"
while [[ -n "$d" && "$d" != "/" ]]; do
  if [[ -f "$d/build.zig.zon" ]]; then
    want="$(sed -nE 's/.*\.minimum_zig_version = "([0-9]+\.[0-9]+).*".*/\1/p' "$d/build.zig.zon" | head -1)"
    break
  fi
  d="$(dirname "$d")"
done

if [[ -n "$want" ]] && command -v "zig-$want" >/dev/null 2>&1; then
  exec "zig-$want" "$@"
fi

# Fall through to the real system zig (skipping this shim so it can't recurse).
IFS=: read -r -a dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  [[ -x "$d/zig" ]] || continue
  if [[ "$(cd "$d" 2>/dev/null && pwd -P)/zig" != "$self" ]]; then
    exec "$d/zig" "$@"
  fi
done
echo "zig shim: no real zig found on PATH" >&2
exit 127
